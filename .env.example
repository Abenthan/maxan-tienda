# ============================================================
# maxan-tienda — Variables de entorno
# Copiar a .env.dev (desarrollo) o .env.prod (producción).
#
# Uso:
#   docker compose -f docker-compose.dev.yml  --env-file .env.dev  up
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ============================================================

# --- Servidor ---
PORT=3007
NODE_ENV=development

# --- Base de datos (PostgreSQL del ERP, compartida) ---
# DEV  → host.docker.internal:5433 (contenedor maxan_db_dev del ERP, puerto host estandarizado)
# PROD → maxan_db:5432 (contenedor postgres del ERP en la red maxan_shared)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- JWT (JWT_SECRET DEBE SER IDÉNTICO al de maxan-auth / ERP) ---
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- CORS (con credentials; orígenes de la tienda) ---
CORS_ORIGINS=http://localhost:5178

# --- URL pública (para enlaces en el webhook de n8n) ---
PUBLIC_URL=http://localhost:5178

# --- Webhook a n8n (cotización creada). Vacío = desactivado ---
# N8N_WEBHOOK_URL=https://n8n.maxansistemas.com/webhook/...
N8N_WEBHOOK_URL=

# --- SSO (frontend, modo castellanizado) ---
# true = el login/registro delega a maxan-auth (SSO). false = sin SSO.
VITE_AUTH_DELEGATED=true
# URL pública del frontend de auth. PROD → https://auth.maxansistemas.com ; DEV → http://localhost:5175
VITE_AUTH_URL=https://auth.maxansistemas.com
# Proxy del API de auth en dev (backend de auth en el host). En contenedor Docker usa host.docker.internal.
VITE_AUTH_SSO_PROXY=http://host.docker.internal:3006
# Proxy del API de la tienda en dev (backend de la tienda).
VITE_API_PROXY=http://tienda-backend:3007
