# ============================================================
# maxan-tienda — DESARROLLO
# Conecta a la PostgreSQL del ERP (maxan_db_dev), estandarizado en el
# puerto host 5433. Mismo JWT_SECRET que maxan-auth/ERP en dev.
#
# Uso:
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up
# ============================================================

NODE_ENV=development
PORT=3007

# PostgreSQL del ERP (desarrollo): host.docker.internal:5433
DB_HOST=host.docker.internal
DB_PORT=5433
DB_USER=maxan_user
DB_PASSWORD=dev_password_segura
DB_NAME=maxan_erp

# Mismo valor que el fallback dev del ERP/auth (maxan-erp-secret-dev)
JWT_SECRET=maxan-erp-secret-dev
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:5178

PUBLIC_URL=http://localhost:5178

N8N_WEBHOOK_URL=

# --- SSO (frontend) ---
VITE_AUTH_DELEGATED=true
VITE_AUTH_URL=http://localhost:5175
VITE_AUTH_SSO_PROXY=http://host.docker.internal:3006
VITE_API_PROXY=http://tienda-backend:3007
